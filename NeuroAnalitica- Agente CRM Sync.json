    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nitems.forEach(item => {\n  const lead = item.json;\n  \n  // Determina la próxima acción según prioridad\n  let proximaAccion = \"Seguimiento estándar en 48h\";\n  if (lead.Prioridad === \"urgente_clinico\") {\n    proximaAccion = \"Contactar HOY — revisión clínica inmediata\";\n  } else if (lead.Prioridad === \"alta\") {\n    proximaAccion = \"Contactar en 24h\";\n  } else if (lead.Prioridad === \"baja\") {\n    proximaAccion = \"Seguimiento en 5 días o descartar\";\n  }\n\n  results.push({\n    json: {\n      Nombre: lead.Nombre,\n      Mensaje: lead.Mensaje,\n      Categoria: lead.Categoria,\n      Score_Total: lead.Score_Total,\n      Prioridad: lead.Prioridad,\n      Fecha_Registro: new Date().toISOString().split('T')[0],\n      Proxima_Accion: proximaAccion,\n      Estado: \"nuevo\"\n    }\n  });\n});\n\nreturn results;"
      },
