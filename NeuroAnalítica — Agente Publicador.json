    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\n// Fecha base: próximo lunes\nconst today = new Date();\nconst daysUntilMonday = (1 + 7 - today.getDay()) % 7 || 7;\nconst monday = new Date(today);\nmonday.setDate(today.getDate() + daysUntilMonday);\n\n// Horarios óptimos para Instagram\nconst horarios = [\n  \"09:00\", \"12:00\", \"18:00\", \"20:00\",\n  \"09:00\", \"12:00\", \"18:00\", \"20:00\",\n  \"09:00\", \"12:00\", \"18:00\", \"20:00\",\n  \"09:00\", \"12:00\"\n];\n\n// Días de la semana (lunes a domingo)\nconst dias = [0, 0, 0, 1, 1, 1, 2, 2, 3, 3, 4, 4, 5, 6];\n\nitems.forEach((item, index) => {\n  const fechaPublicacion = new Date(monday);\n  fechaPublicacion.setDate(monday.getDate() + dias[index]);\n  const fecha = fechaPublicacion.toISOString().split('T')[0];\n\n  results.push({\n    json: {\n      Semana: item.json.Semana,\n      Titulo: item.json.Titulo,\n      Formato: item.json.Formato,\n      Pilar: item.json.Pilar,\n      Fecha: fecha,\n      Hora: horarios[index],\n      Estado: \"programado\"\n    }\n  });\n});\n\nreturn results;"
      },
