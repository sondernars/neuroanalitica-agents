      "parameters": {
        "jsCode": "const metricas = $('Get row(s) in sheet').all().map(item => item.json);\nconst leads = $('Get row(s) in sheet1').all().map(item => item.json);\n\nreturn [{\n  json: {\n    metricas_resumen: JSON.stringify(metricas),\n    leads_resumen: JSON.stringify(leads),\n    total_piezas: metricas.length,\n    total_leads: leads.length\n  }\n}];"
