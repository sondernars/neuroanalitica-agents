      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst metricas = items.map(i => ({\n  Pieza: i.json.Pieza,\n  Views: i.json.Views,\n  Guardados: i.json.Guardados,\n  DMs: i.json.DMs\n}));\n\nconst leads = items.map(i => ({\n  Nombre: i.json.Nombre,\n  Categoria: i.json.Categoria,\n  Score_Total: i.json.Score_Total,\n  Prioridad: i.json.Prioridad\n}));\n\nreturn [{\n  json: {\n    metricas_resumen: JSON.stringify(metricas),\n    leads_resumen: JSON.stringify(leads),\n    total_piezas: metricas.length,\n    total_leads: leads.length\n  }\n}];"
      },
